{
  "name": "fun-song-recommender",
  "version": "1.0.0",
  "description": "Interactive song recommendation app with Tinder-style cards",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "start": "node server/index.js"
  },
  "keywords": ["music", "recommendations", "spotify"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "sqlite3": "^5.1.6",
    "axios": "^1.6.0",
    "@anthropic-ai/sdk": "^0.20.0"
  },
  "devDependencies": {
    "concurrently": "^8.2.1"
  }
}
